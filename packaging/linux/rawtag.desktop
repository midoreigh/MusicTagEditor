[Desktop Entry]
Type=Application
Name=RawTag
GenericName=Audio Tag Editor
Comment=View and edit every raw tag in audio files
Exec=rawtag %F
Icon=rawtag
Terminal=false
Categories=AudioVideo;Audio;
MimeType=audio/mpeg;audio/mp4;audio/x-m4a;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-wav;audio/x-aiff;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;
